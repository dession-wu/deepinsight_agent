# DeepInsight Agent 环境变量模板
# 使用方法: cp .env.example .env 然后填入真实值（.env 已被 .gitignore 忽略，不会入库）

# ===== LLM（必填，不设置时 /health 正常但 /analyze 返回 503）=====
# DeepSeek 平台 API Key
OPENAI_API_KEY=
# API 基础地址（默认 https://api.deepseek.com）
OPENAI_BASE_URL=https://api.deepseek.com
# 模型名（默认 deepseek-chat）
MODEL_NAME=deepseek-chat

# ===== Langfuse 监控（可选，默认关闭）=====
# 总开关，设为 true 且双密钥齐全才启用
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Langfuse 服务地址（自部署时填写，默认 https://cloud.langfuse.com）
LANGFUSE_HOST=https://cloud.langfuse.com
# 调试日志（默认 false）
LANGFUSE_DEBUG=false